/*
 * {{ title }}
 * Generated by tinyml {{ version }} from model.json ({{ algorithm }}, {{ quantization }}).
 * Regenerate instead of editing by hand.
 *
 * Fill a window with TINYML_WINDOW_SAMPLES readings, interleaved by axis:
 *   window[i * TINYML_NUM_AXES + a] is sample i of axis a ({{ axes|join(", ") }}).
 * Then call model_predict(window).
 */
#ifndef TINYML_MODEL_H
#define TINYML_MODEL_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

#define TINYML_WINDOW_SAMPLES {{ window_samples }}
#define TINYML_NUM_AXES {{ num_axes }}
#define TINYML_SAMPLE_RATE_HZ {{ rate_c }}
#define TINYML_HOP_SAMPLES {{ hop }}
#define TINYML_NUM_FEATURES {{ num_features }}
#define TINYML_NUM_CLASSES {{ num_classes }}
#define TINYML_TASK_ANOMALY {{ 1 if task == "anomaly" else 0 }}

typedef struct {
    int32_t label; /* index into tinyml_class_names */
    float score;   /* {{ score_doc }} */
} tinyml_result_t;

extern const char *const tinyml_class_names[TINYML_NUM_CLASSES];
extern const char *const tinyml_axis_names[TINYML_NUM_AXES];
extern const char *const tinyml_feature_names[TINYML_NUM_FEATURES];

/* Computes the model's input features for one window (used by the parity test). */
void model_features(const float *window, float *features);

/* Runs the model on one window. */
tinyml_result_t model_predict(const float *window);
{% if task == "anomaly" %}

/*
 * Calibration on first install: feed windows recorded while the machine runs normally
 * at its new site, then call model_calibrate_end(). Returns 0 on success, -1 if fewer
 * than TINYML_CALIBRATION_MIN_WINDOWS windows were given (nothing is changed then).
 * Use model_calibration_get/set to keep the result across reboots (for example in NVS).
 */
#define TINYML_CALIBRATION_MIN_WINDOWS 20
#define TINYML_CALIBRATION_SIZE {{ calibration_size }}
void model_calibrate_begin(void);
void model_calibrate_add(const float *window);
int model_calibrate_end(void);
void model_calibration_get(float *out);
void model_calibration_set(const float *in);
{% endif %}

#ifdef __cplusplus
}
#endif

#endif /* TINYML_MODEL_H */
