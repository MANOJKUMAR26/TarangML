{% if needs_maxf %}
static float tm_maxf(float a, float b)
{
    return a > b ? a : b;
}

{% endif %}
{% if needs_sqrt %}
#if defined(__ARM_FP) && (__ARM_FP & 4)
static float tm_sqrtf(float x)
{
    return x > 0.0f ? __builtin_sqrtf(x) : 0.0f; /* single VSQRT.F32, correctly rounded */
}
#else
/* Correctly rounded single-precision square root using integer maths only. */
static float tm_sqrtf(float x)
{
    union {
        float f;
        uint32_t u;
    } v;
    v.f = x;
    if (!(x > 0.0f)) {
        return 0.0f;
    }
    if ((v.u & 0x7f800000u) == 0x7f800000u) {
        return x;
    }
    int32_t e = (int32_t)((v.u >> 23) & 0xffu);
    uint32_t m = v.u & 0x7fffffu;
    if (e == 0) {
        while (!(m & 0x800000u)) {
            m <<= 1;
            e--;
        }
        e++;
        m &= 0x7fffffu;
    }
    m |= 0x800000u;
    e -= 127;
    if (e & 1) {
        m <<= 1;
        e--;
    }
    uint64_t a = (uint64_t)m << 23;
    uint64_t r = 0;
    uint64_t bit = (uint64_t)1 << 48;
    while (bit > a) {
        bit >>= 2;
    }
    while (bit != 0) {
        if (a >= r + bit) {
            a -= r + bit;
            r = (r >> 1) + bit;
        } else {
            r >>= 1;
        }
        bit >>= 2;
    }
    if (a > r) {
        r++;
    }
    if (r >= ((uint64_t)1 << 24)) {
        r >>= 1;
        e += 2;
    }
    v.u = ((uint32_t)(e / 2 + 127) << 23) | ((uint32_t)r & 0x7fffffu);
    return v.f;
}
#endif
{% endif %}

